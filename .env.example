# Environment Variables Example
# Copy this file to .env and fill in the values

# Database (auto-provisioned by Drytis)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# LLM API (Hugging Face OpenAI-compatible router)
LLM_API_KEY=your_hf_token_here
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita

# Indian Kanoon API
IK_API_KEY=your_ik_api_key
IK_BASE_URL=https://api.indiankanoon.org

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# Engine settings
CACHE_TTL_DAYS=7
CURRENT_YEAR=2026